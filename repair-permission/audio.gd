extends Node
## Minimal diegetic soundscape: room tone, two terminal idles, UI one-shots,
## and the low hum that starts after PUMP 3 --ACCEPT-NEW.
## All assets are generated by tools/generate_audio.py; no external samples.

const ROOM_TONE := preload("res://audio/room_tone.wav")
const OLD_IDLE := preload("res://audio/old_idle.wav")
const NEW_IDLE := preload("res://audio/new_idle.wav")
const TENSION_HUM := preload("res://audio/tension_hum.wav")
const OLD_PRINT := preload("res://audio/old_print.wav")
const OLD_RELAY := preload("res://audio/old_relay.wav")
const NEW_TICK := preload("res://audio/new_tick.wav")
const NEW_CHIME := preload("res://audio/new_chime.wav")

const ROOM_DB := -17.0
const OLD_DB := -21.0
const NEW_DB := -24.0
const TENSION_DB := -21.0
const PRINT_POOL_SIZE := 4

var room_player: AudioStreamPlayer
var old_player: AudioStreamPlayer
var new_player: AudioStreamPlayer
var tension_player: AudioStreamPlayer

var tension_on := false
var new_layer_on := false

var _print_players: Array[AudioStreamPlayer] = []
var _print_index := 0
var _relay_player: AudioStreamPlayer
var _tick_player: AudioStreamPlayer
var _chime_player: AudioStreamPlayer
var _tension_tween: Tween
var _new_tween: Tween
var _room_tween: Tween
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	room_player = _make_loop(ROOM_TONE, ROOM_DB)
	old_player = _make_loop(OLD_IDLE, OLD_DB)
	new_player = _make_loop(NEW_IDLE, -60.0, false)
	tension_player = _make_loop(TENSION_HUM, -60.0, false)

	for _i in PRINT_POOL_SIZE:
		_print_players.append(_make_one(OLD_PRINT, -16.0))
	_relay_player = _make_one(OLD_RELAY, -15.0)
	_tick_player = _make_one(NEW_TICK, -22.0)
	_chime_player = _make_one(NEW_CHIME, -14.0)


func _make_loop(stream: AudioStream, volume: float, autoplay := true) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.stream = _looped(stream)
	player.volume_db = volume
	add_child(player)
	if autoplay:
		player.play()
	return player


func _make_one(stream: AudioStream, volume: float) -> AudioStreamPlayer:
	var player := AudioStreamPlayer.new()
	player.stream = stream
	player.volume_db = volume
	add_child(player)
	return player


func _looped(stream: AudioStream) -> AudioStream:
	var wav := stream.duplicate() as AudioStreamWAV
	if wav == null:
		return stream
	wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wav.loop_begin = 0
	wav.loop_end = int(wav.get_length() * float(wav.mix_rate))
	return wav


func on_boot_done() -> void:
	new_layer_on = true
	new_player.play()
	_fade_new(NEW_DB, 1.4)
	play_tick(-21.0)


func play_relay() -> void:
	_relay_player.pitch_scale = _rng.randf_range(0.96, 1.04)
	_relay_player.play()


func play_tick(volume: float = -22.0) -> void:
	_tick_player.volume_db = volume
	_tick_player.pitch_scale = _rng.randf_range(0.98, 1.02)
	_tick_player.play()


func play_chime() -> void:
	_chime_player.play()


func on_submit() -> void:
	play_relay()
	play_tick(-24.0)


func on_old_print(dim: bool = false) -> void:
	var player := _print_players[_print_index]
	_print_index = (_print_index + 1) % _print_players.size()
	player.pitch_scale = _rng.randf_range(0.93, 1.07)
	player.volume_db = -25.0 if dim else -16.0
	player.play()


func on_new_say() -> void:
	if not new_layer_on:
		new_layer_on = true
		_fade_new(NEW_DB, 0.8)
	play_tick(-25.0)


func on_player_input() -> void:
	if not new_layer_on:
		new_layer_on = true
		_fade_new(NEW_DB, 0.8)


func on_accept_new() -> void:
	if not tension_on:
		tension_on = true
		tension_player.volume_db = -60.0
		tension_player.play()
		_fade_tension(TENSION_DB, 2.5)
	play_chime()


func on_scan_start() -> void:
	if not tension_on:
		return
	tension_on = false
	if _tension_tween != null and _tension_tween.is_valid():
		_tension_tween.kill()
	_tension_tween = create_tween()
	_tension_tween.tween_property(tension_player, "volume_db", -60.0, 1.8)
	_tension_tween.tween_callback(tension_player.stop)


func on_kill() -> void:
	new_layer_on = false
	_fade_new(-60.0, 2.2)


func on_ending_start() -> void:
	if not tension_on:
		return
	tension_on = false
	if _tension_tween != null and _tension_tween.is_valid():
		_tension_tween.kill()
	_tension_tween = create_tween()
	_tension_tween.tween_property(tension_player, "volume_db", -60.0, 2.0)


func on_black_screen() -> void:
	new_layer_on = false
	_fade_new(-60.0, 1.4)
	_fade_room(-26.0, 1.4)


func on_ending_complete() -> void:
	tension_on = false
	new_layer_on = false
	var tween := create_tween()
	tween.set_parallel(true)
	tween.tween_property(room_player, "volume_db", -60.0, 4.0)
	tween.tween_property(old_player, "volume_db", -60.0, 4.0)
	tween.tween_property(new_player, "volume_db", -60.0, 3.0)
	tween.tween_property(tension_player, "volume_db", -60.0, 2.0)
	tween.chain().tween_callback(_stop_all)


func _fade_new(target_db: float, duration: float) -> void:
	if _new_tween != null and _new_tween.is_valid():
		_new_tween.kill()
	_new_tween = create_tween()
	_new_tween.tween_property(new_player, "volume_db", target_db, duration)


func _fade_tension(target_db: float, duration: float) -> void:
	if _tension_tween != null and _tension_tween.is_valid():
		_tension_tween.kill()
	_tension_tween = create_tween()
	_tension_tween.tween_property(tension_player, "volume_db", target_db, duration)


func _fade_room(target_db: float, duration: float) -> void:
	if _room_tween != null and _room_tween.is_valid():
		_room_tween.kill()
	_room_tween = create_tween()
	_room_tween.tween_property(room_player, "volume_db", target_db, duration)


func _stop_all() -> void:
	for player in _print_players:
		player.stop()
	_relay_player.stop()
	_tick_player.stop()
	_chime_player.stop()
	room_player.stop()
	old_player.stop()
	new_player.stop()
	tension_player.stop()
